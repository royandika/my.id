---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Blog — Roy Andika, M.Kom."
  description="Catatan seputar IT Infrastructure, Machine Learning, dan teknologi."
  activePage="blog"
>
  <main class="mx-auto max-w-6xl px-5 lg:px-10">
    <!-- HERO -->
    <section class="border-b border-cream-300 py-16 dark:border-white/10">
      <span class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-cream-600 dark:text-cream-500">
        <span class="size-1.5 rounded-full bg-brand-500"></span>
        Blog
      </span>
      <h1 class="mt-4 text-4xl font-normal leading-tight tracking-[-0.02em] md:text-5xl">
        Catatan<span class="text-brand-500">.</span>
      </h1>
      <p class="mt-4 max-w-xl text-sm/relaxed text-cream-700 dark:text-cream-500">
        Artikel, tutorial, opini dan berbagai hal mengenai IT, machine learning, AI,
        dan hal-hal teknis maupun umum yang layak dibagikan.
      </p>
    </section>

    <!-- TOOLBAR: meta + search + filter label -->
    <section class="border-b border-cream-300 py-5 dark:border-white/10">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-3">
          <!-- Meta teks -->
          <span id="blog-meta" class="font-mono text-xs text-cream-500 dark:text-cream-600">
            Memuat…
          </span>
          <!-- Label filter chips -->
          <div id="label-filters" class="flex flex-wrap gap-1.5"></div>
        </div>

        <!-- Search -->
        <div class="relative">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-cream-400"
          >
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
          </svg>
          <input
            id="search-input"
            type="search"
            placeholder="Cari postingan…"
            class="h-9 w-56 rounded-md border border-cream-300 bg-white pl-9 pr-4 text-sm placeholder:text-cream-400 focus:border-brand-400 focus:outline-none dark:border-white/10 dark:bg-white/5 dark:text-cream-200 dark:placeholder:text-cream-600 dark:focus:border-brand-500"
          />
        </div>
      </div>
    </section>

    <!-- POSTS LIST -->
    <section class="py-8">
      <!-- Loading spinner -->
      <div id="state-loading" class="flex items-center justify-center py-24">
        <span class="inline-flex items-center gap-3 font-mono text-sm text-cream-500">
          <svg class="size-5 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
          </svg>
          Mengambil data dari Blogger…
        </span>
      </div>

      <!-- Error state -->
      <div
        id="state-error"
        class="hidden rounded-xl border border-cream-300 bg-white p-10 text-center dark:border-white/10 dark:bg-white/5"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mx-auto mb-3 size-8 text-cream-400"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 8v4"></path>
          <path d="M12 16h.01"></path>
        </svg>
        <p class="font-mono text-sm text-cream-600 dark:text-cream-500" id="error-message">Gagal memuat.</p>
        <button
          onclick="fetchPosts()"
          class="mt-5 inline-flex h-9 items-center gap-2 rounded-md border border-cream-300 px-4 text-sm hover:bg-cream-50 dark:border-white/10 dark:hover:bg-white/5 cursor-pointer"
        >
          ↺ Coba lagi
        </button>
      </div>

      <!-- Empty / no result -->
      <div
        id="state-empty"
        class="hidden rounded-xl border border-cream-300 bg-white p-10 text-center dark:border-white/10 dark:bg-white/5"
      >
        <p class="font-mono text-sm text-cream-500">Tidak ada postingan yang cocok.</p>
        <button
          onclick="clearFilters()"
          class="mt-4 inline-flex h-9 items-center gap-2 rounded-md border border-cream-300 px-4 text-sm hover:bg-cream-50 dark:border-white/10 dark:hover:bg-white/5 cursor-pointer"
        >
          Hapus filter
        </button>
      </div>

      <!-- Posts list -->
      <div id="posts-list" class="hidden overflow-hidden rounded-xl border border-cream-300 dark:border-white/10"></div>

      <!-- Pagination -->
      <div id="pagination" class="mt-6 hidden items-center justify-between">
        <button
          id="btn-prev"
          onclick="changePage(-1)"
          class="inline-flex h-9 items-center gap-2 rounded-md border border-cream-300 px-4 text-sm hover:bg-cream-50 disabled:cursor-not-allowed disabled:opacity-35 dark:border-white/10 dark:hover:bg-white/5 cursor-pointer"
        >
          ← Sebelumnya
        </button>
        <span id="page-info" class="font-mono text-xs text-cream-500 dark:text-cream-600"></span>
        <button
          id="btn-next"
          onclick="changePage(1)"
          class="inline-flex h-9 items-center gap-2 rounded-md border border-cream-300 px-4 text-sm hover:bg-cream-50 disabled:cursor-not-allowed disabled:opacity-35 dark:border-white/10 dark:hover:bg-white/5 cursor-pointer"
        >
          Berikutnya →
        </button>
      </div>
    </section>
  </main>

  <script is:inline>
    const CONFIG = {
      blogUrl: "https://blog.royandika.my.id",
      postsPerPage: 10,
      summaryLength: 180,
      maxFetch: 500,
    };

    const COLORS = [
      "bg-lavender/25 text-cream-900 dark:text-cream-100",
      "bg-azure/25 text-cream-900 dark:text-cream-100",
      "bg-mint/25 text-cream-900 dark:text-cream-100",
      "bg-peach/25 text-cream-900 dark:text-cream-100",
      "bg-gold/25 text-cream-900 dark:text-cream-100",
    ];
    const colorCache = {};
    let colorIdx = 0;
    function labelBadgeClass(tag) {
      if (!colorCache[tag]) colorCache[tag] = COLORS[colorIdx++ % COLORS.length];
      return colorCache[tag];
    }

    let allPosts = [];
    let filtered = [];
    let activeLabelFilter = null;
    let currentPage = 1;

    const $ = id => document.getElementById(id);
    const elLoading = $("state-loading");
    const elError = $("state-error");
    const elEmpty = $("state-empty");
    const elList = $("posts-list");
    const elPaginate = $("pagination");
    const elMeta = $("blog-meta");
    const elSearch = $("search-input");
    const elFilters = $("label-filters");
    const elBtnPrev = $("btn-prev");
    const elBtnNext = $("btn-next");
    const elPageInfo = $("page-info");

    function fmtDate(iso) {
      return new Date(iso).toLocaleDateString("id-ID", {
        day: "numeric", month: "long", year: "numeric"
      });
    }

    function stripHtml(html) {
      const d = document.createElement("div");
      d.innerHTML = html;
      return d.textContent || d.innerText || "";
    }

    function thumb(entry) {
      const m = entry["media$thumbnail"];
      if (m?.url) return m.url.replace(/\/s\d+\//, "/s480/");
      const match = (entry.content?.$t || "").match(/<img[^>]+src=["']([^"']+)["']/i);
      return match ? match[1] : null;
    }

    function labels(entry) {
      return (entry.category || []).map(c => c.term);
    }

    function postUrl(entry) {
      return (entry.link || []).find(l => l.rel === "alternate")?.href || "#";
    }

    function renderRow(p, visibleIndex) {
      const num = String(visibleIndex).padStart(2, "0");
      const img = p.thumb
        ? `<div class="relative h-full w-28 shrink-0 overflow-hidden sm:w-36">
           <img src="${p.thumb}" alt="${p.title}"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy" onerror="this.closest('div').remove()" />
         </div>`
        : "";

      const chips = p.labels.length
        ? p.labels.slice(0, 3).map(l =>
          `<span class="rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-tight ${labelBadgeClass(l)}">${l}</span>`
        ).join("")
        : `<span class="rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-tight bg-azure/25 text-cream-900 dark:text-cream-100">Blog</span>`;

      return `
      <article class="group flex min-h-[6.5rem] border-b border-cream-300 last:border-b-0
                      bg-white hover:bg-cream-50 transition-colors duration-150
                      dark:bg-transparent dark:hover:bg-white/4 dark:border-white/10">
        ${img}
        <a href="${p.url}" target="_blank" rel="noopener"
           class="flex flex-1 flex-col justify-between gap-2 p-4 sm:p-5">
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex flex-wrap gap-1.5">${chips}</div>
              <span class="font-mono text-[10px] text-cream-400 dark:text-cream-600">${num}</span>
            </div>
            <h2 class="mt-2.5 text-[0.9375rem] font-medium leading-snug tracking-tight
                       line-clamp-2 group-hover:text-brand-600 dark:group-hover:text-brand-400
                       transition-colors duration-150">
              ${p.title}
            </h2>
            <p class="mt-1.5 text-sm/relaxed text-cream-600 dark:text-cream-500 line-clamp-2">
              ${p.summary}
            </p>
          </div>
          <div class="flex items-center justify-between pt-1">
            <span class="font-mono text-[11px] text-cream-400 dark:text-cream-600">${p.date}</span>
            <span class="inline-flex items-center gap-1 text-[11px] font-medium text-brand-500
                         opacity-0 group-hover:opacity-100 transition-opacity duration-150">
              Baca
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                class="size-3">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </span>
          </div>
        </a>
      </article>`;
    }

    function renderPage() {
      const total = filtered.length;
      const totalPages = Math.max(1, Math.ceil(total / CONFIG.postsPerPage));
      const start = (currentPage - 1) * CONFIG.postsPerPage;
      const slice = filtered.slice(start, start + CONFIG.postsPerPage);

      [elError, elEmpty, elList, elPaginate].forEach(el => {
        el.classList.add("hidden");
        el.classList.remove("flex", "grid", "block");
      });

      if (total === 0) {
        elEmpty.classList.remove("hidden");
        return;
      }

      elList.innerHTML = slice.map((p, i) => renderRow(p, start + i + 1)).join("");
      elList.classList.remove("hidden");

      if (totalPages > 1) {
        elPaginate.classList.remove("hidden");
        elPaginate.classList.add("flex");
        elPageInfo.textContent = `Hal. ${currentPage} / ${totalPages} · ${total} postingan`;
        elBtnPrev.disabled = currentPage <= 1;
        elBtnNext.disabled = currentPage >= totalPages;
      }
    }

    function applyFilters() {
      const q = elSearch.value.toLowerCase().trim();
      filtered = allPosts.filter(p => {
        const matchLabel = !activeLabelFilter || p.labels.includes(activeLabelFilter);
        const matchSearch = !q || (
          p.title.toLowerCase().includes(q) ||
          p.summary.toLowerCase().includes(q) ||
          p.labels.some(l => l.toLowerCase().includes(q))
        );
        return matchLabel && matchSearch;
      });
      currentPage = 1;
      updateMeta();
      renderPage();
    }

    function updateMeta() {
      const q = elSearch.value.trim();
      const f = activeLabelFilter;
      if (q || f) {
        elMeta.textContent = `${filtered.length} dari ${allPosts.length} postingan`;
      } else {
        elMeta.textContent = `${allPosts.length} postingan`;
      }
    }

    function renderLabelChips(posts) {
      const counts = {};
      posts.forEach(p => p.labels.forEach(l => counts[l] = (counts[l] || 0) + 1));
      const sorted = Object.entries(counts)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 8);

      elFilters.innerHTML = sorted.map(([lbl, count]) => {
        return `<button onclick="toggleLabel('${lbl}')"
                id="chip-${lbl.replace(/\\s+/g, '-')}"
                class="label-chip rounded-full border border-cream-300 px-2.5 py-0.5
                       text-[10px] font-semibold uppercase tracking-tight
                       text-cream-700 hover:bg-cream-200
                       dark:border-white/10 dark:text-cream-400 dark:hover:bg-white/10
                       transition-colors duration-150 cursor-pointer">
                ${lbl} <span class="opacity-50">${count}</span>
              </button>`;
      }).join("");
    }

    window.toggleLabel = function (label) {
      activeLabelFilter = activeLabelFilter === label ? null : label;
      document.querySelectorAll(".label-chip").forEach(btn => {
        const isActive = btn.textContent.trim().startsWith(activeLabelFilter || "__none__");
        btn.classList.toggle("bg-cream-900", isActive);
        btn.classList.toggle("text-cream-50", isActive);
        btn.classList.toggle("dark:bg-white", isActive);
        btn.classList.toggle("dark:text-cream-950", isActive);
        btn.classList.toggle("border-transparent", isActive);
      });
      applyFilters();
    };

    window.clearFilters = function () {
      activeLabelFilter = null;
      elSearch.value = "";
      applyFilters();
      document.querySelectorAll(".label-chip").forEach(btn => {
        btn.classList.remove("bg-cream-900", "text-cream-50", "dark:bg-white", "dark:text-cream-950", "border-transparent");
      });
    };

    window.changePage = function (dir) {
      currentPage += dir;
      renderPage();
      window.scrollTo({ top: 0, behavior: "smooth" });
    };

    window.fetchPosts = function () {
      elLoading.classList.remove("hidden");
      [elError, elEmpty, elList, elPaginate].forEach(el => {
        el.classList.add("hidden");
        el.classList.remove("flex");
      });
      elMeta.textContent = "Memuat…";

      const cbName = "_blogFeedCb_" + Date.now();

      const timer = setTimeout(() => {
        cleanup();
        showFetchError("Waktu habis. Periksa koneksi internet.");
      }, 15000);

      function cleanup() {
        clearTimeout(timer);
        delete window[cbName];
        const old = document.getElementById("_blogFeedJsonp");
        if (old) old.remove();
      }

      function showFetchError(msg) {
        elLoading.classList.add("hidden");
        const errMsg = $("error-message");
        if (errMsg) errMsg.textContent = msg;
        elError.classList.remove("hidden");
        elMeta.textContent = "Gagal memuat.";
      }

      window[cbName] = function (data) {
        cleanup();
        const entries = data.feed?.entry || [];
        if (!entries.length) {
          showFetchError("Feed kosong — blog ini belum memiliki postingan.");
          return;
        }

        allPosts = entries.map((e, i) => ({
          index: i + 1,
          title: e.title?.$t || "(tanpa judul)",
          summary: (e.summary?.$t
            ? stripHtml(e.summary.$t)
            : stripHtml(e.content?.$t || "")
          ).trim().slice(0, CONFIG.summaryLength) + "…",
          date: fmtDate(e.published?.$t || ""),
          url: postUrl(e),
          labels: labels(e),
          thumb: thumb(e),
        }));

        filtered = [...allPosts];
        elLoading.classList.add("hidden");
        renderLabelChips(allPosts);
        updateMeta();
        renderPage();
      };

      const s = document.createElement("script");
      s.id = "_blogFeedJsonp";
      s.src = `${CONFIG.blogUrl}/feeds/posts/default/-/Indonesia?alt=json-in-script&callback=${cbName}&max-results=${CONFIG.maxFetch}&orderby=published`;
      s.onerror = () => { cleanup(); showFetchError("Gagal memuat feed blog. Pastikan URL blog benar dan publik."); };
      document.head.appendChild(s);
    };

    elSearch.addEventListener("input", applyFilters);
    fetchPosts();
  </script>
</Layout>
