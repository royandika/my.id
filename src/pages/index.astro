  <!-- Client-side Blog loader for recent posts -->
  <script is:inline>
    (function () {
      const BLOG_URL = "https://blog.royandika.my.id";
      const MAX_POSTS = 3;
      const SUMMARY_LEN = 120;

      const elLoading = document.getElementById("blog-loading");
      const elError = document.getElementById("blog-error");
      const elCards = document.getElementById("blog-cards");

      function fmtDate(iso) {
        return new Date(iso).toLocaleDateString("id-ID", {
          day: "numeric", month: "long", year: "numeric"
        });
      }
      function stripHtml(html) {
        const d = document.createElement("div");
        d.innerHTML = html;
        return d.textContent || d.innerText || "";
      }
      function getThumb(entry) {
        const m = entry["media$thumbnail"];
        if (m?.url) return m.url.replace(/\/s\d+\//, "/s320/");
        const match = (entry.content?.$t || "").match(/<img[^>]+src=["']([^"']+)["']/i);
        return match ? match[1] : null;
      }
      function getUrl(entry) {
        return (entry.link || []).find(l => l.rel === "alternate")?.href || "#";
      }

      function renderCard(entry, isLast) {
        const title = entry.title?.$t || "(tanpa judul)";
        const date = fmtDate(entry.published?.$t || "");
        const url = getUrl(entry);
        const thumb = getThumb(entry);
        const rawText = entry.summary?.$t
          ? stripHtml(entry.summary.$t)
          : stripHtml(entry.content?.$t || "");
        const summary = rawText.trim().slice(0, SUMMARY_LEN) + "…";
        const border = isLast ? "" : "border-b border-cream-300 dark:border-white/10";

        const thumbHtml = thumb
          ? `<div class="relative w-24 sm:w-28 shrink-0 overflow-hidden">
               <img src="${thumb}" alt="${title}"
                    class="h-full w-full object-cover transition-transform duration-300
                           group-hover:scale-105"
                    loading="lazy" onerror="this.closest('div').remove()" />
             </div>`
          : "";

        return `
          <article class="group ${border} flex min-h-[6rem] hover:bg-cream-50 dark:hover:bg-white/4
                            transition-colors duration-150">
            ${thumbHtml}
            <a href="${url}" target="_blank" rel="noopener"
               class="flex flex-1 flex-col justify-between gap-1 p-4 sm:p-5">
              <div>
                <p class="font-mono text-[10px] text-cream-400 dark:text-cream-600">${date}</p>
                <h3 class="mt-1 text-[0.9375rem] font-medium leading-snug tracking-tight
                           line-clamp-2 group-hover:text-brand-600 dark:group-hover:text-brand-400
                           transition-colors duration-150">
                  ${title}
                </h3>
                <p class="mt-1.5 text-sm/relaxed text-cream-600 dark:text-cream-500 line-clamp-2">
                  ${summary}
                </p>
              </div>
              <span class="inline-flex items-center gap-1.5 font-mono text-xs
                           text-brand-500 opacity-0 group-hover:opacity-100
                           transition-opacity duration-150">
                Baca selengkapnya
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                  stroke-linejoin="round" class="size-3">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </span>
            </a>
          </article>`;
      }

      function showError(msg) {
        if (!elLoading || !elError) return;
        elLoading.classList.add("hidden");
        const msgEl = document.getElementById("blog-error-msg");
        if (msgEl) msgEl.textContent = "Gagal memuat: " + msg;
        elError.classList.remove("hidden");
      }

      window.loadLatestPosts = function () {
        if (!elLoading || !elError || !elCards) return;
        elLoading.classList.remove("hidden");
        elError.classList.add("hidden");
        elCards.classList.add("hidden");

        const cbName = "_blogCb_" + Date.now();
        const timer = setTimeout(() => {
          cleanup();
          showError("Waktu habis. Periksa koneksi internet.");
        }, 10000);

        function cleanup() {
          clearTimeout(timer);
          delete window[cbName];
          const old = document.getElementById("_blogJsonp");
          if (old) old.remove();
        }

        window[cbName] = function (data) {
          cleanup();
          const entries = (data.feed?.entry || []).slice(0, MAX_POSTS);
          if (!entries.length) { showError("Belum ada postingan."); return; }

          elCards.innerHTML = entries
            .map((e, i) => renderCard(e, i === entries.length - 1))
            .join("");

          elLoading.classList.add("hidden");
          elCards.classList.remove("hidden");
        };

        const s = document.createElement("script");
        s.id = "_blogJsonp";
        s.src = `${BLOG_URL}/feeds/posts/default/-/Indonesia?alt=json-in-script&callback=${cbName}&max-results=${MAX_POSTS}&orderby=published`;
        s.onerror = () => { cleanup(); showError("Gagal memuat feed blog."); };
        document.head.appendChild(s);
      };

      loadLatestPosts();
    })();
  </script>
