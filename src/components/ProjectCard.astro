---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const num = String(project.id).padStart(2, "0");

const colorBadgeClasses: Record<string, string> = {
  gold: "bg-gold/25 text-cream-900 dark:text-cream-100",
  azure: "bg-azure/25 text-cream-900 dark:text-cream-100",
  mint: "bg-mint/25 text-cream-900 dark:text-cream-100",
  peach: "bg-peach/25 text-cream-900 dark:text-cream-100",
  lavender: "bg-lavender/25 text-cream-900 dark:text-cream-100",
};

const badgeClass = colorBadgeClasses[project.tagColor] || "bg-azure/25 text-cream-900 dark:text-cream-100";
---

<article class="group flex flex-col rounded-xl border border-cream-300 bg-white p-6 dark:border-white/10 dark:bg-white/5">
  <div class="flex items-center justify-between gap-3">
    <span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold uppercase tracking-tight ${badgeClass}`}>
      {project.tags}
    </span>
    <span class="font-mono text-xs text-cream-600 dark:text-cream-500">{num}</span>
  </div>
  <h3 class="mt-5 text-[1.25rem] md:text-[1.375rem] font-normal leading-snug tracking-tight">
    {project.title}
  </h3>
  <p class="mt-3 flex-1 text-sm/relaxed text-cream-700 dark:text-cream-500">
    {project.desc}
  </p>
  <a
    href={project.linkUrl}
    target="_blank"
    rel="noopener"
    class="mt-5 inline-flex items-center gap-2 font-mono text-xs text-cream-900 underline decoration-cream-400 underline-offset-4 hover:decoration-cream-900 dark:text-white dark:decoration-white/30 dark:hover:decoration-white"
  >
    {project.linkLabel}
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
    >
      <path d="M7 7h10v10" /><path d="M7 17 17 7" />
    </svg>
  </a>
</article>
