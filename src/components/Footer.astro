---
const year = new Date().getFullYear();
---

<footer class="border-t border-cream-300 dark:border-white/10">
  <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-3 px-5 py-8 text-sm text-cream-700 sm:flex-row sm:items-center lg:px-10 dark:text-cream-500">
    <p>
      CV &copy; {year} · Roy Andika, M.Kom.
    </p>
    <p class="inline-flex items-center gap-1.5">
      <span>Crafted with</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="inline-block size-4 text-brand-500"
      >
        <path
          d="m9.653 16.915-.005-.003-.019-.01a20.759 20.759 0 0 1-1.162-.682 22.045 22.045 0 0 1-2.582-1.9C4.045 12.733 2 10.352 2 7.5a4.5 4.5 0 0 1 8-2.828A4.5 4.5 0 0 1 18 7.5c0 2.852-2.044 5.233-3.885 6.82a22.049 22.049 0 0 1-3.744 2.582l-.019.01-.005.003h-.002a.739.739 0 0 1-.69.001l-.002-.001Z"
        />
      </svg>
      <span>by
        <a
          href="https://pixelcave.com"
          target="_blank"
          rel="noopener"
          class="font-medium text-cream-900 underline decoration-cream-400 underline-offset-4 hover:decoration-cream-900 dark:text-white dark:decoration-white/30 dark:hover:decoration-white"
        >pixelcave</a>
      </span>
    </p>
  </div>
</footer>
